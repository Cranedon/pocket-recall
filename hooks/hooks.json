{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "UV_PROJECT_ENVIRONMENT=\"${CLAUDE_PLUGIN_DATA}/venv\" uv run --quiet --frozen --no-dev --project \"${CLAUDE_PLUGIN_ROOT}\" pocket-recall hook",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
