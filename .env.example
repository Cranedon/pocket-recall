# Read by `pocket-recall eval` (copy to .env, which is gitignored). Only the providers you use need keys.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=          # a relay, if you use one

# OpenAI-compatible providers: --answer-model openai:gpt-5, deepseek:deepseek-chat, ...
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# MOONSHOT_API_KEY=
# OPENROUTER_API_KEY=
# Any other server: --answer-model mylab:my-model
# MYLAB_BASE_URL=http://localhost:8000/v1
# MYLAB_API_KEY=
